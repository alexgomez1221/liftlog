.DS_Store
**/.DS_Store
Thumbs.db
*.zip
*.tgz
node_modules/
.vercel
.env
.env.local
*.log
liftlog-backup-*.json

# ---- Terraform ----
# State can contain secrets and is authoritative — it belongs in S3, not git.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Real variable values. Commit the .example instead.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Lambda zip built by archive_file — reproducible from api/ source
infra/modules/api/.build/

override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# NOTE: .terraform.lock.hcl is deliberately NOT ignored.
# It pins provider versions and hashes — commit it so CI and your laptop
# resolve identical providers. Gitignoring it is a common mistake.

# Scanner output, produced by a local checkov run
*.sarif
