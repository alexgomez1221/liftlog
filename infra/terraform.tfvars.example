# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# alert_email is the only value you MUST set here. Everything else has a
# working default in variables.tf.
#
# Do NOT put callback_urls or logout_urls here unless you are deploying to a
# different URL than the committed default. CI has no access to this file, so
# anything set only here makes local plans disagree with CI plans — which is
# exactly how the Cognito callback URLs got silently reverted to localhost on
# a merge to main. Change the default in variables.tf instead.

# Where CloudWatch alarms are sent. Set as the ALERT_EMAIL repo secret in CI.
alert_email = "you@example.com"

# Optional overrides:
# callback_urls       = ["https://your-app.example/", "http://localhost:8080/"]
# logout_urls         = ["https://your-app.example/", "http://localhost:8080/"]
# aws_region          = "us-east-1"
# project             = "liftlog"
# env                 = "prod"
# deletion_protection = true
