# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

# Where Cognito may redirect after login. Must match EXACTLY, trailing slash
# included. Add your deployed app URL once you know it, e.g.
#   callback_urls = ["https://liftlog.vercel.app/", "http://localhost:8080/"]
callback_urls = ["http://localhost:8080/"]
logout_urls   = ["http://localhost:8080/"]

# Optional overrides:
# aws_region          = "us-east-1"
# project             = "liftlog"
# env                 = "prod"
# deletion_protection = true
